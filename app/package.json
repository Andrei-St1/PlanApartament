{
  "name": "plan-apartament",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Plan 3D al apartamentului (Ap. 3, Str. Pârâului 15, Brașov) cu salvare comună pe server",
  "scripts": {
    "dev": "concurrently -k -n server,web \"node --watch server/server.js\" \"vite\"",
    "build": "vite build",
    "start": "node server/server.js",
    "cf:dev": "cd .. && npx --prefix app wrangler dev",
    "cf:deploy": "cd .. && npx --prefix app wrangler deploy"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "4.21.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.160.0",
    "ws": "8.18.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "concurrently": "9.1.2",
    "vite": "5.4.11",
    "wrangler": "4.164.0"
  }
}
